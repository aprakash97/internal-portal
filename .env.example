# PostgreSQL database connection string
DATABASE_URL="your-database-connection-string"

# Secret key for Better Auth - generate this when setting up Better Auth
BETTER_AUTH_SECRET="your-better-auth-secret"

# Application URL - use http://localhost:3000 for local development
BETTER_AUTH_URL="http://localhost:3000"

# UploadThing token - create an UploadThing project and add the generated token
UPLOADTHING_TOKEN="your-uploadthing-token"